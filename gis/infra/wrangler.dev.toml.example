# DEV TEMPLATE ONLY — NO DEPLOY until real IDs, Access and approvals are verified.
# Provision resources manually and record proof in docs/foundation/environment-inventory.md.
name = "analise-gis-dev"
main = "../apps/api/src/index.js"
compatibility_date = "2026-10-18"
workers_dev = false
[vars]
DEPLOY_ENV = "dev"
[[d1_databases]]
binding = "GIS_DB"
database_name = "analise-gis-dev-db"
database_id = "DEV_D1_UUID_REQUIRED"
[[r2_buckets]]
binding = "GIS_R2"
bucket_name = "analise-gis-dev-geodata"
[[kv_namespaces]]
binding = "GIS_KV"
id = "DEV_KV_ID_REQUIRED"
[[queues.producers]]
binding = "GIS_QUEUE"
queue = "analise-gis-dev-jobs"
