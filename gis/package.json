{
  "name": "analise-gis-foundation",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/contracts"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @gis/web",
    "build": "npm run build --workspace @gis/web",
    "typecheck": "tsc --noEmit -p packages/contracts/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "check:isolation": "node scripts/check-isolation.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check": "npm run check:isolation && npm run check:secrets && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "typescript": "~5.8.3",
    "vite": "^6.3.0",
    "@vitejs/plugin-react": "^4.4.1"
  }
}
